      "refersTo": "panel",
      "description": "White workspace or authentication container separated by a thin border.",
      "html": "<section class=\"ds-panel\"><h2>Introduce your store</h2><p>Authorization details stay private to you and our reviewers.</p></section>",
      "css": ".ds-panel{font-family:var(--font-primary,\"Satoshi\",sans-serif);background:#fff;border:1px solid var(--partner-line,#dce5ef);border-radius:14px;padding:30px;color:var(--partner-ink,#192943)}.ds-panel h2{margin:0 0 8px;font-size:22px;font-weight:750;line-height:1.3;letter-spacing:-.015em}.ds-panel p{margin:0;color:var(--partner-muted,#52647c);font-size:14px;line-height:1.7}@media(max-width:540px){.ds-panel{padding:22px 16px;border-radius:10px}}"
    },
    {
      "name": "Explained review lock",
      "kind": "custom",
      "description": "Explains disabled editing and offers an available next step.",
      "html": "<div class=\"ds-lock\"><p><strong>This submission is in review.</strong>To make changes, withdraw the submission from Overview, edit your draft, then submit it again.</p><button class=\"ds-secondary\" type=\"button\">Open Overview</button></div>",
      "css": ".ds-lock{font-family:var(--font-primary,\"Satoshi\",sans-serif);display:flex;align-items:center;justify-content:space-between;gap:20px;padding:18px 0;margin-bottom:25px;border-block:1px solid var(--partner-line,#dce5ef)}.ds-lock p{margin:0;color:var(--partner-muted,#52647c);font-size:13px;line-height:1.7}.ds-lock strong{display:block;color:var(--partner-ink,#192943);margin-bottom:5px}.ds-lock button{flex-shrink:0}.ds-secondary{font-family:var(--font-primary,\"Satoshi\",sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:46px;padding:12px 19px;border-radius:8px;font-size:14px;font-weight:700;line-height:1.4;text-align:center;cursor:pointer;transition:background-color 150ms,border-color 150ms;border:1px solid #bccbdc;background:#fff;color:var(--partner-ink,#192943)}.ds-secondary:hover{background:#edf3fa;border-color:#879eb9}.ds-secondary:focus-visible{outline:3px solid #759be7;outline-offset:4px;}.ds-secondary:disabled{cursor:not-allowed;opacity:.58}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}@media(max-width:540px){.ds-lock{align-items:start;flex-direction:column;gap:12px}}"
    }
