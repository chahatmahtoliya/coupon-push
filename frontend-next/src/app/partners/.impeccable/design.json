      "refersTo": "button-secondary",
      "description": "A visible alternative action, including returning to Overview.",
      "html": "<button class=\"ds-secondary\" type=\"button\">Open Overview</button>",
      "css": ".ds-secondary{font-family:var(--font-primary,\"Satoshi\",sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:46px;padding:12px 19px;border-radius:8px;font-size:14px;font-weight:700;line-height:1.4;text-align:center;cursor:pointer;transition:background-color 150ms,border-color 150ms;border:1px solid #bccbdc;background:#fff;color:var(--partner-ink,#192943)}.ds-secondary:hover{background:#edf3fa;border-color:#879eb9}.ds-secondary:focus-visible{outline:3px solid #759be7;outline-offset:4px;}.ds-secondary:disabled{cursor:not-allowed;opacity:.58}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}"
    },
    {
      "name": "Text action",
      "kind": "button",
      "description": "Underlined links for small management actions.",
      "html": "<button class=\"ds-text\" type=\"button\">Edit offer</button>",
      "css": ".ds-text{font-family:var(--font-primary,\"Satoshi\",sans-serif);min-height:44px;padding:6px 0;border:0;background:transparent;color:var(--partner-accent,#235ebc);font-size:13px;font-weight:650;text-decoration:underline;text-underline-offset:3px;cursor:pointer}.ds-text:focus-visible{outline:3px solid #759be7;outline-offset:4px;}.ds-text:hover{color:#174893}.ds-text:disabled{cursor:not-allowed;opacity:.58}"
    },
    {
      "name": "Labeled field",
      "kind": "input",
      "refersTo": "field",
      "description": "Native control with a persistent label and described hint.",
      "html": "<div class=\"ds-field\"><label for=\"ds-store-name\">Store name <span>(required)</span></label><input id=\"ds-store-name\" aria-describedby=\"ds-store-hint\" type=\"text\" /><p id=\"ds-store-hint\">Complete required details before submitting for review.</p></div>",
      "css": ".ds-field{font-family:var(--font-primary,\"Satoshi\",sans-serif);display:grid;gap:8px;color:var(--partner-ink,#192943)}.ds-field label{font-size:14px;font-weight:650;line-height:1.5}.ds-field label span{font-size:12px;font-weight:400;color:var(--partner-muted,#52647c)}.ds-field input{font-family:var(--font-primary,\"Satoshi\",sans-serif);width:100%;min-height:46px;padding:11px 12px;border:1px solid #b9c8da;border-radius:7px;background:#fff;color:var(--partner-ink,#192943);font-size:15px;line-height:1.5}.ds-field input:focus-visible{outline:3px solid #759be7;outline-offset:4px;}.ds-field input[aria-invalid=\"true\"]{border-color:#af3d50}.ds-field p{margin:0;font-size:12px;line-height:1.65;color:var(--partner-muted,#52647c)}.ds-field input:disabled{cursor:not-allowed;background:#f5f7fb;color:#52647c}"
    },
    {
      "name": "Workspace navigation",
      "kind": "nav",
      "description": "Text-led workspace destinations with a tinted current item.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Brand workspace\"><button type=\"button\" aria-current=\"page\">Overview</button><button type=\"button\">Store details</button><button type=\"button\">Coupons &amp; offers</button></nav>",
      "css": ".ds-nav{font-family:var(--font-primary,\"Satoshi\",sans-serif);display:grid;gap:5px;max-width:220px}.ds-nav button{font-family:var(--font-primary,\"Satoshi\",sans-serif);min-height:48px;padding:12px;border:0;border-radius:7px;background:transparent;color:#425773;font-size:14px;text-align:left;cursor:pointer}.ds-nav button:hover{background:#edf2f9}.ds-nav button[aria-current=\"page\"]{background:#e7effc;color:#1a509e;font-weight:750}.ds-nav button:focus-visible{outline:3px solid #759be7;outline-offset:4px;}@media(max-width:800px){.ds-nav{display:flex;max-width:100%;overflow-x:auto;gap:6px}.ds-nav button{flex-shrink:0;white-space:nowrap}}"
    },
    {
