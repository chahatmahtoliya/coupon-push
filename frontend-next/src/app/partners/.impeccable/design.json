      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Save a draft or submit a completed review request.",
      "html": "<button class=\"ds-primary\" type=\"button\">Save offer draft</button>",
      "css": ".ds-primary{font-family:var(--font-primary,\"Satoshi\",sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:46px;padding:12px 19px;border-radius:8px;font-size:14px;font-weight:700;line-height:1.4;text-align:center;cursor:pointer;transition:background-color 150ms,border-color 150ms;border:1px solid var(--partner-accent,#235ebc);background:var(--partner-accent,#235ebc);color:#fff;}.ds-primary:hover{background:#174893;border-color:#174893}.ds-primary:focus-visible{outline:3px solid #759be7;outline-offset:4px;}.ds-primary:disabled{cursor:not-allowed;opacity:.58}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
